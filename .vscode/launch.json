{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Docker: Attach to pipeline",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "/app/src"
                },
                {
                    "localRoot": "${workspaceFolder}/scripts",
                    "remoteRoot": "/app/scripts"
                }
            ]
        }
    ]
}
