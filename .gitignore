# Datos (contenido gitignoreado, estructura conservada con .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/output/*
!data/output/.gitkeep
logs/*
!logs/.gitkeep

# Config local (overrides personales)
config.local.yaml

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
*.egg-info/
dist/
build/
.eggs/

# Herramientas
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDEs
.vscode/*
!.vscode/launch.json
.idea/
*.swp
*.swo
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/